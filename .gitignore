# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Data & cache directories (Triage)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/emsr927/*
!data/emsr927/.gitkeep

# Environment variables & secrets
.env
env
*.env
*.env.local
.streamlit/secrets.toml

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
wheels/

# Testing & cache
.pytest_cache/
.coverage
htmlcov/
.cache/

# OS generated files
.DS_Store
Thumbs.db

# KuroSiwo training data (too large for git)
data/kurosiwo/*
!data/kurosiwo/.gitkeep
!data/kurosiwo/README.md

# Trained model weights (too large for git)
p2_ai/models/*.pth
p2_ai/models/*.pt
p2_ai/models/*.onnx
p2_ai/models/*.npz
p2_ai/models/*.h5
data/models/*.pth
data/models/*.pt
data/models/*.onnx
data/models/*.npz
data/models/*.h5
!data/models/.gitkeep
!data/models/README.md

# Run output directories
data/runs/*/
!data/runs/.gitkeep
!data/runs/README.md

# Docs generated files
docs/report.pdf
docs/figures/*.png
docs/figures/*.jpg
docs/figures/*.svg

# Root legacy shims (optional)
/app/
/src/
